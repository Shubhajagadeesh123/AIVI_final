# AIVisualAssistant environment variables
DATABASE_URL=sqlite:///blindmate.db
GEMINI_API_KEY=your_gemini_api_key
SESSION_SECRET=change-this-secret
SMTP_EMAIL=
SMTP_PASSWORD=
GOOGLE_MAPS_API_KEY=

# Optional automatic emergency SMS + voice call (Twilio)
# Trial accounts can use different sender numbers for Messaging and Voice.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_VOICE_FROM_NUMBER=
# Backwards-compatible fallback if both product-specific numbers are the same.
TWILIO_PHONE_NUMBER=
